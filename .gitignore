# Godot 4+ specific ignores
.godot/
/android/

# C# / .NET build output
**/bin/
**/obj/

# Debug/release symbols
*.pdb

# Export/build artifacts
export/
build/
releases/
dist/
out/
Exports/

# Image assets are local-only.
Assets/Images/*

# Question and category data are user data, not repository content.
Resources/Questions/
Resources/Categories/

# Media copied from the system file picker for questions.
Assets/Media/Questions/

# IDE/Editor
.vs/
.vscode/
.idea/
*.sln.iml

*.csproj.user
*.user

*.zip