# Godot 4+ specific ignores
.godot/
/android/

# C# / .NET build output
**/bin/
**/obj/

# Debug/release symbols
*.pdb

# Export/build artifacts
export/
build/
releases/
dist/
out/
Exports/

# App images are local-only (the default team picture referenced by the team card scene).
Assets/Images/*

# Question and category data are user data, not repository content.
Resources/Questions/
Resources/Categories/

# Question media picked through the Question Creator (images and audio) is local-only.
Assets/Media/

# IDE/Editor
.vs/
.vscode/
.idea/
*.sln.iml

*.csproj.user
*.user

*.zip
# Godot import sidecars for documentation images are editor artifacts.
docs/**/*.import
