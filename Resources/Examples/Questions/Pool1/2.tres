[resource]
script = ExtResource("2")
Id = "example-jedzenie-kisiel"
QuestionText = "Co to kisiel owsiany?"
AnswersText = Array[String](["fermentowany deser z mąki lub płatków owsianych", "owsianka z bardzo drobno zmielonej mąki owsianej", "woda, która zostaje po namoczeniu płatków owsianych", "owsianka zrobiona na zsiadłym mleku"])
Category = ExtResource("1")
FunFact = "Klasyczny kisiel owsiany powstaje przez namoczenie płatków, mąki lub ziaren owsa w wodzie z dodatkiem zakwasu chlebowego, chleba żytniego, drożdży lub kefiru i odstawienie na kilkanaście do kilkudziesięciu godzin."
